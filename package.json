{
  "name": "drift-studio",
  "productName": "Drift Studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drift Studio — personal gaming session, OBS control and clip editing workstation.",
  "main": "dist-electron/main/main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.desktop.json",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:renderer": "node --test tests/*.test.mjs",
    "test:services": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "npm run build && node scripts/build-desktop.mjs && electron .",
    "desktop:safe": "npm run build && node scripts/build-desktop.mjs && electron . --safe-mode",
    "desktop:package": "npm run build && node scripts/build-desktop.mjs && node scripts/fetch-voice-model.mjs && electron-builder --win nsis --x64",
    "test:e2e": "npm run build && node scripts/build-desktop.mjs && node tests/electron-e2e/run.mjs",
    "fetch:voice-model": "node scripts/fetch-voice-model.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/bangers": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/black-ops-one": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@playwright/test": "1.51.1",
    "@types/node": "^22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "obs-websocket-js": "^5.0.8",
    "typescript": "^7.0.2",
    "vite": "5.4.21",
    "vitest": "^3.2.4",
    "vosk-browser": "0.0.8",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "studio.drift.desktop",
    "productName": "Drift Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "*.tar.gz"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DriftStudio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  }
}
